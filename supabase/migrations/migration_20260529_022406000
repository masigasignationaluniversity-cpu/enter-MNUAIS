-- Add session token column to profiles
ALTER TABLE profiles ADD COLUMN IF NOT EXISTS session_token text DEFAULT NULL;

-- Function: create/update session token for a user (called on login)
CREATE OR REPLACE FUNCTION set_session_token(p_username text, p_token text)
RETURNS void
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
BEGIN
  UPDATE profiles
  SET session_token = CASE WHEN p_token = '' THEN NULL ELSE p_token END
  WHERE username = p_username;
END;
$$;

-- Function: verify session token is still valid (called periodically)
CREATE OR REPLACE FUNCTION verify_session_token(p_username text, p_token text)
RETURNS boolean
LANGUAGE plpgsql
SECURITY DEFINER
AS $$
DECLARE
  v_valid boolean;
BEGIN
  SELECT EXISTS(
    SELECT 1 FROM profiles
    WHERE username = p_username
      AND session_token = p_token
      AND session_token IS NOT NULL
  ) INTO v_valid;
  RETURN v_valid;
END;
$$;