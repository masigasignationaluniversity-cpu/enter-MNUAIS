-- 1. Create courses table
CREATE TABLE IF NOT EXISTS courses (
  id text NOT NULL PRIMARY KEY,
  code text NOT NULL,
  title text NOT NULL,
  units integer NOT NULL DEFAULT 3,
  lab_units integer,
  type text NOT NULL DEFAULT 'Lec',
  department text NOT NULL DEFAULT '',
  is_pe boolean NOT NULL DEFAULT false,
  is_nstp boolean NOT NULL DEFAULT false,
  prerequisites jsonb DEFAULT '[]',
  corequisites jsonb DEFAULT '[]',
  requires_coi boolean DEFAULT false,
  requires_dept_consent boolean DEFAULT false,
  requires_ocs_consent boolean DEFAULT false,
  min_units_required integer,
  min_year_standing text,
  created_at timestamptz DEFAULT now()
);

ALTER TABLE courses ENABLE ROW LEVEL SECURITY;

CREATE POLICY "courses_all" ON courses
  USING (true) WITH CHECK (true);

