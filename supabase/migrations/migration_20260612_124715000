-- Add missing tables to realtime publication (IF NOT ALREADY ADDED)
DO $$
BEGIN
  -- app_settings (key-value store for requests, consents, enlistments, etc.)
  IF NOT EXISTS (
    SELECT 1 FROM pg_publication_tables
    WHERE pubname = 'supabase_realtime' AND tablename = 'app_settings'
  ) THEN
    ALTER PUBLICATION supabase_realtime ADD TABLE "app_settings";
  END IF;

  -- prerogatives
  IF NOT EXISTS (
    SELECT 1 FROM pg_publication_tables
    WHERE pubname = 'supabase_realtime' AND tablename = 'prerogatives'
  ) THEN
    ALTER PUBLICATION supabase_realtime ADD TABLE "prerogatives";
  END IF;

  -- underload_applications
  IF NOT EXISTS (
    SELECT 1 FROM pg_publication_tables
    WHERE pubname = 'supabase_realtime' AND tablename = 'underload_applications'
  ) THEN
    ALTER PUBLICATION supabase_realtime ADD TABLE "underload_applications";
  END IF;

  -- graduation_requirements (may already exist)
  IF NOT EXISTS (
    SELECT 1 FROM pg_publication_tables
    WHERE pubname = 'supabase_realtime' AND tablename = 'graduation_requirements'
  ) THEN
    ALTER PUBLICATION supabase_realtime ADD TABLE "graduation_requirements";
  END IF;

  -- graduation_applications (may already exist)
  IF NOT EXISTS (
    SELECT 1 FROM pg_publication_tables
    WHERE pubname = 'supabase_realtime' AND tablename = 'graduation_applications'
  ) THEN
    ALTER PUBLICATION supabase_realtime ADD TABLE "graduation_applications";
  END IF;
END $$;